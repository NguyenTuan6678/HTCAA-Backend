# ==============================================================================
# HTCAA Backend Configuration Example File
# Copy this file to '.env' and fill in your local / production values.
# ==============================================================================

# Application Settings
PORT=4000
APP_NAME="Mikan ♥"
NODE_ENV=development

# Database Settings
# Replace with your MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/htcaa
MONGODB_NAME=htcaa

# JWT Configuration
# Generate secure keys (e.g., using `openssl rand -base64 32`)
JWT_SECRET=your_jwt_fallback_secret_key_here
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRATION=12h

# Email settings (via Resend provider)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=onboarding@resend.dev

# URL Configuration
# Note: FRONTEND_URL is used for CORS validation
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_username
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET=minio_bucket
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
MINIO_PRESIGNED_EXPIRES_IN=3600
